# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501
API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=15
EVALUATION_API_TOKEN=

# LLM — fake is the safe default and requires no credential
LLM_PROVIDER=fake
LLM_MODEL=fake-deterministic
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_CHARACTERS=20000

# Natural-language and prompt context budgets
QUESTION_MAX_CHARACTERS=2000
PROMPT_SCHEMA_MAX_TABLES=8
PROMPT_SCHEMA_MAX_CHARACTERS=12000
PROMPT_SEMANTIC_MAX_CHARACTERS=8000
VERIFIED_QUERY_MAX_EXAMPLES=3

# Databases — configured when their implementation phase begins
ANALYTICS_DATABASE_URL=postgresql+psycopg://analytics_readonly:change-me@localhost:55432/chinook
METADATA_DATABASE_URL=postgresql+psycopg://app_metadata_user:change-me@localhost:55432/analyst_metadata
ANALYTICS_SCHEMA=analytics
METADATA_SCHEMA=app_metadata

# Query safety budgets
QUERY_TIMEOUT_SECONDS=5
QUERY_MAX_ROWS=500
QUERY_MAX_COLUMNS=100
QUERY_MAX_RESPONSE_BYTES=5000000
QUERY_MAX_REPAIR_ATTEMPTS=2
CSV_MAX_BYTES=1000000

# Deterministic result presentation and local metadata budgets
CHART_MAX_CATEGORIES=50
CHART_MAX_GROUPED_MEASURES=3
CHART_RECOMMENDED_LINE_POINTS=8
CHART_RECOMMENDED_SCATTER_POINTS=8
QUERY_HISTORY_MAX_ENTRIES=100

# SQL AST security policy
SQL_DIALECT=postgres
SQL_MAX_QUERY_CHARACTERS=12000
SQL_ALLOW_EXPLAIN=false
SQL_BLOCKED_FUNCTIONS=["pg_sleep","dblink","load_extension","readfile","writefile"]

# Versioned behavior
PROMPT_VERSION=v2
SEMANTIC_VERSION=v1-postgresql

# Feature and privacy defaults
ENABLE_QUERY_HISTORY=true
ENABLE_RESULT_SUMMARY=true
STORE_RAW_QUESTION=false
STORE_RAW_SQL=false
STORE_RESULT_ROWS=false

# JSON array parsed by Pydantic Settings
CORS_ALLOWED_ORIGINS=["http://localhost:8501"]
